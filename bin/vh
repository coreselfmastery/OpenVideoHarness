#!/usr/bin/env bash
# vh — OpenVideoHarness helper. Run from anywhere: bin/vh <command>
#  set up
#   doctor                      check the toolchain (node, ffmpeg, chrome + a headless WebGL probe, python/uv, latex) and what the first runs still download
#   setup                       install ClaudeAnimationBase deps + fetch reference repos
#   install-skill [claude|codex|all]  register the open-video-harness skill (~/.claude/skills, ~/.agents/skills)
#   sync-agents                 regenerate AGENTS.md from CLAUDE.md (keep both agents' entry points identical)
#  make
#   types                       list video types and their docs
#   effort [quick|standard|studio]  how much iteration, review and polish each level means (CLAUDE.md and playbook/01 "努力程度")
#   new <type> <slug> [--style <preset[,preset]>] [--effort quick|standard|studio] [--aspect 16:9|9:16|1:1|4:5|3:4] [--watch phone|feed|desktop] [--res 1080p|4k] [--lang zh|en] [--engine canvas-film] [--dir <folder>]
#                               create projects/<date>-<slug> from templates (+ engine: p5 for handdrawn/mv, HyperFrames for short/promo/data/meme);
#                               --engine canvas-film: the narration-driven canvas engine instead, any type, 16:9 (engines/canvas-film/README.md);
#                               --aspect: short/promo/data/meme only (4:5 is 1080x1350, 3:4 1080x1440, both 1080p only); --lang: the review pages' language (default zh; set it from the user's first request);
#                               --dir (or $OVH_PROJECTS): make it in <folder>/<date>-<slug> outside the harness
#   style list | <preset> [--draft] | gallery [--mp4] | check <preset>   style library: list presets, render a 5 s swatch, build styles/gallery.jpg
#                               (the swatch render's other options: styles/_swatch/render.sh -h)
#   recipes list [--intent X --energy N --engine E …] | check [file…]   shot recipes (recipes/): filter by frontmatter, validate it
#   hf-init <dir> [frame]       scaffold HyperFrames into a project safely (no global skill install); frame: landscape|portrait|square|4:5|3:4
#                               (the composition size; 4K is a render flag, render --resolution 4k, not a frame)
#  decide: pictures and pages for the human
#   storyboard <project> [--video v.mp4 | --snapshot] [--unsure S02,S04]   labelled storyboard pages from shots.json: one per segment + an overview (+ review.json)
#   rhythm <project> [--segment NAME | --from s --to s] [--max s]   rhythm map: shots, narration and captions, music; too-long shots and failed reads in red
#   style compare a,b,c [--frame t] | style apply <preset[,preset]> <project>   presets side by side (posters, or swatch frames at t) / attach presets to a project as references
#   cover-preview <image> [more…] [--text-px N]   a cover at real feed sizes (Bilibili, Douyin, YouTube, Xiaohongshu) + a small-size legibility check
#   review <project> [gate]     decision-first review page: out/review/gate-<gate>.json → gate-<gate>.html (+ index.html); prints the chat message (playbook/01-pipeline.md, 审阅页)
#   desk <project> [--port N] | desk wait <project> [--timeout s] | desk feedback <project> [--round r] [--json] | desk data <project>
#                               the review desk (studio's review surface, tools/desk/README.md): a local page on 127.0.0.1 where the reviewer
#                               ticks, comments and submits; wait: block until they submit, print it, exit 0 (an agent runs it in the background);
#                               feedback: the latest submission; data: what the desk reads from the project, as JSON
#  sound
#   tts <project> [provider] [voice] [zh|en] [instruct] [--beats map.json] [--align gemini] [--join block|all] [--resume]  voiceover from audio/script.txt
#                               (中文 || English; [direction] per line; lines snap to beats; @speakers A=Kore B=Puck + "A: …" lines = a dialogue;
#                               --align gemini: word timestamps + ASR-vs-script check per line; --join: several lines per request;
#                               --resume: continue the last run after a failed synthesis or transcription, same script and command)
#                               providers: qwen (default, local open-source Qwen3-TTS) | say | edge | dashscope | elevenlabs | gemini | gemini-lite | minimax
#   pace <project> [zh|en] [--ref <id>[-<id>] | --target N] [--strength 0.8] [--clamp 0.92,1.18] [--tolerance 0.05] [--pause 0.26] [--extra id=s,…] [--align map|gemini|whisper] [--dry-run] [--restore] [--skip-lint]
#                               optional: bring the pace of the lines in one take closer (part of the way, natural variation kept), no new synthesis;
#                               --dry-run only measures. The original stays as voiceover.<lang>.raw.wav; captions are redone;
#                               a timeline that fails bin/vh timeline is refused (--skip-lint to go on; --restore never stops on one)
#   voices list [lang] | design "<description>" [--out f.wav] | delete <voice_id>   Gemini voice library / voice design
#   captions <project> [zh|en] [zh-max] [--en-max 42] [--cards] [--cps 9] [--media-end S] [--skip-lint]  SRT (zh / en / bilingual) + captions.json
#                               from the TTS timeline, broken at word boundaries (jieba through uv) and audio/capbreaks.json; --cards: one line a
#                               caption, cut there and timed by the words, never across a sentence end; a caption under its minimum (1.8 s, or its
#                               Chinese at --cps a second, other text at 20) is lengthened into the gap after it, up to the picture's end (--media-end, else index.html's data-duration,
#                               media/final.mp4, the timeline); two less than 0.25 s apart touch;
#                               a timeline that fails bin/vh timeline is refused (--skip-lint to go on)
#   timeline <project|timeline.json> [zh|en]  the narration timeline's checks: lines in order, word times forward and inside their line, the words
#                               spelling the line's text (exit 1 on a problem); tts prints them, captions and pace refuse a timeline that fails
#   remap <file.json> --from old.timeline.json --to new.timeline.json [--keys t,start,end,at,time] [--out f] [--skip-lint]   seconds typed into a
#                               sound script or an events list, moved to a new take of the narration through the words both timelines share;
#                               without --out the file is rewritten and the original kept as <file>.bak (refused when a .bak is there);
#                               lines rewritten, gone or reordered are listed with the times that fall on them
#   beats <audio> [out.json]    beat grid (bpm, offset, beats, downbeats) + hits, kick/snare accents (librosa)
#   music <score.json> <out.wav> [--length s|auto] [--roll] | music --example [name|list] | music --instruments   code-composed soundtrack + exact beat/section map
#                               --length: end exactly there with a musical fade (auto: where the last bar ends); --roll: piano roll + energy curve per part (PNG)
#   sfx lib <dir> | sfx place <events.json> <out.wav> [dur]   built-in SFX library / place SFX on action times (stereo, pan/dist)
#                               each event of a built-in gets a variant, a step along its film's walk for that sound (pin one:
#                               "variant": n), and can be shaped to its move: dur, pitch|center, dir up|down, bright, tone,
#                               pan_from/pan_to (tools/audio/sfx.py has the details); sfx lib also writes sfx-lib.json
#   sfx audition <name|all> [n=8] [dur=… dir=…] [--walk] [--out f.wav] [--png]   hear a family: n variants 0.6 s apart (--walk: one
#                               film's n in a row) + a line each (+ spectrogram)
#   mix <out.wav> [voice=…] [music=…] [sfx=…] [music_db=-6]   3-bus mix, music ducks under the voice (duck=on: + SFX), −14 LUFS
#   mix <out.wav> profile=explainer|short|promo|cartoon|mv|swatch [voice=…] [music=…] [events=… lib=…] [timeline=…] [stems=DIR]
#                               a level hierarchy from one anchor (the narration, else the music): VMR per line, SFX classes, depth
#   qa <mix> [beats.json] [events.json] [--stems DIR]  final-mix QA: silence, dropouts, pumping, clicks + cue check (+ qa mix) (exit 1 on fail)
#   qa mix <stems dir>          the mix report of a profile mix: VMR per line, words at risk, SFX classes, depth (exit 1 on a hard miss)
#   mux <video> <audio> <out> [--subs-off] [subs.srt…]  audio track (+ soft zh/en subtitle tracks) onto a rendered video, moov first
#                               (--subs-off: no subtitle track starts switched on, for a picture with burned-in captions)
#  check
#   readcheck <texts.json|project|index.html> [--pace relaxed|normal|brisk] [--mode onscreen|label|subtitle] [--lang zh|en]  reading time, no fixed seconds:
#                               FAIL under one brisk read (CJK/7 + other/20 + 0.8 s, at least 1.5 s; exit 1), WARN under the target of the BRIEF's
#                               Pace (exit 0); subtitles within reading speed. data-read="subtitle"|"label" and data-pace="…" mark clips
#                               readcheck --budget <s>: how many characters fit in a span · readcheck <index.html|project> --export [--out f]: the composition's timed text
#                               a canvas-film project (film.html): its reads and captions from the page (window.film.texts), written to out/texts.json first
#   textcheck <project|page.html> [--texts f.json] [--min-visible 0.7] [--min-contrast 3] [--samples 3] [--scan-step 1] [--caption-step 0.5] [--caption-close 0.12] [--ui-step 1] [--ui-share 0.002] [--out dir] [--soft-gl] [--timeout 900]
#                               text drawn into a canvas, which npx hyperframes check cannot see: a read covered by the picture (under 70% of it
#                               shows), under 3:1, outside or cut by the frame, or under a DOM caption (exit 1); canvas text outside the registry
#                               and captions over a bright picture warn, and so does a scene drawing under the interface (a page with window.film.ui(t)
#                               and frame(t, { layer: "scene" })). The composition opts in with window.film = { frame(t), duration, texts? }
#                               (engines/CONTRACT.md; the older window.__vh = { draw(t), texts? } still works)
#   frames <project|page.html> (--at t,t… | --range a:b[:step] | --strip a:b | --covers[=A,B]) [--fps 30] [--out dir] [--size WxH] [--dpr 2] [--real-clock]
#                               frames drawn from the source through the page contract (window.film, engines/CONTRACT.md), for any web-page
#                               engine: ClaudeAnimationBase, a page that writes window.film, HyperFrames (a composition without it gets its own
#                               runtime); lossless PNGs in <project>/out/frames; --strip: every frame of a span and one picture of them all;
#                               --covers: the page's covers (window.film.covers; canvas-film COVERS, picked by cue) in <project>/out/covers
#   bake <project|page.html> [--out scene.png] [--at t] [--hide sel,sel…] [--dpr 2]   the static scene frozen into one lossless PNG
#                               (assets/scene.png): what the compositor would re-run every frame although it never changes — a backdrop-filter
#                               blur over static content, stacked glass — becomes one image the page's cheap twin blits (the animated layer,
#                               [data-bake-hide] or --hide, stays live on top); tools/kaggle/fixture/css-cost is the worked example
#   render <project|page.html> [--out f.mp4] [--fps 30] [--range a:b | --frames k0:k1] [--dpr 2] [--workers 4] [--crf 16] [--gop 60] [--png]
#                               an MP4 drawn through the page contract (the canvas engine, ClaudeAnimationBase, any page that writes
#                               window.film): parallel chunks into x264, BT.709 tv range, a keyframe every --gop frames, <out>.render.json
#                               records how; video only (sound: mux). HyperFrames: npx hyperframes render (--force to render it here anyway).
#                               A whole standard or studio film waits for gate ① on record (tools/gatecheck.py); --range and --frames do not
#   patch <film.mp4> (--frames a-b | --seconds s-e) [--sidecar f.render.json] [--out f | --in-place] [--workers 4] [--verify seams|full]
#                               draw frames a–b of a bin/vh render film again and put them back, the rest untouched: cut on its keyframes
#                               (its .render.json says how it was made), joined, sound and subtitles kept; checks the frame count, that every
#                               packet and pixel outside is the film's, decoding, and that the frames drawn again outside a–b came back the same
#                               (exit 1: the new film is kept as <film>.failed.mp4, the film untouched); without --out: <film>.patched.mp4
#   determinism <project|page.html> [--at t,t…] [--samples 6] [--min-psnr 45]   is each frame a function of t? draws the same t
#                               in one browser in two orders and in a second browser, compares them, and again with the real clock
#   fonts check <project|page.html> [--step 0.5] [--at t,…] [--allow-fallback "Apple Color Emoji"] [--strict] [--out dir]   is every character drawn
#                               in the font it asks for? A font without a character falls back to another font, or to none (an empty glyph),
#                               silently: this draws the film at sampled times, notes the canvas and DOM text and asks the browser which
#                               font draws each character (exit 1 on any; out/check/fonts.json). bin/vh render says so too
#   fonts list [words…] [--cjk] | fonts subset <project|page.html> [--family F] [--font file|name] [--out dir]   the faces on this
#                               machine by the names local() takes; the page's local() fonts cut to the characters the project uses (woff2)
#   cues <project|page.html> [--save] [--out f] [--chapters]   where the page's cues landed (window.film.cues: times hung on the narration's
#                               words), in order; --save keeps them in out/cues.json with the timeline's sha256, and a later run says
#                               which cues a new take moved and by how much; --chapters: the chapter list for a description (out/chapters.txt)
#   sheet <video> [cols] [fps] [out]  contact sheet (default: <project>/out/check/<name>-sheet-<HHMMSS>.png)
#   check <video> [--allow t,t…] [--against <ref.mp4>]  ffprobe + the BRIEF's spec (size, rate, length; exit 1 on a mismatch) + gate ①
#                               on record in a standard or studio project (REVIEW.md, DECISIONS.md; exit 1 without it) + the
#                               publishing copy in PACKAGING.md against the platforms' length limits (a warning) +
#                               subtitles (its tracks and the .srt beside it) shorter than it takes to read them (a warning) +
#                               black/freeze/silence detection + isolated-frame scan (one-frame capture glitches; exit 1 on any not declared
#                               with --allow <seconds or spans a-b of designed flashes>; evenly spaced ones are periodic motion, said, not
#                               failed) + motion (hard cuts from dark to bright, still stretches of 3 s or more: warnings) + colour tags; --against: a 4K render vs the approved 1080p cut
#                               (exit 1 when the picture differs: a layout that breaks at device scale 2)
#   gif <video> [width] [fps]   palette-optimised GIF preview (for READMEs)
#  deliver and tidy
#   deliver <master.mp4> [--for bilibili,douyin,youtube] [--max-gb N] [--crf 16] [--out f] [--psnr sample|full|off]   the copy to upload:
#                               the bit rate a platform's file limit leaves for the picture (playbook/10, 交付编码): CRF 16 under it, or two
#                               passes at it when the master's own rate is over it;
#                               a keyframe every 2 s, BT.709, sound and subtitles copied; the size against each limit, the PSNR against the master
#   clean <project> [--yes] [--delete] [--keep path …] [--final f]   a finished project's intermediates (frames, render chunks, drafts,
#                               old takes, stems, node_modules) to the Trash; the film, covers, captions, review pages, sources, docs and the
#                               narration in use stay. Without --yes it only lists them; --delete deletes what the tools can make again
set -euo pipefail
unset CDPATH   # an exported CDPATH would send a relative cd (this one: bin/vh run as bin/vh) to another folder, and print it
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
c_ok=$'\033[32m✓\033[0m'; c_no=$'\033[31m✗\033[0m'; c_wa=$'\033[33m!\033[0m'

declare -a TYPES=(
  "math:01-math-science-explainer:数学/科学原理讲解（Manim）"
  "short:02-knowledge-short:知识科普短视频，含竖屏（HyperFrames）"
  "promo:03-product-promo:产品宣传/发布片（HyperFrames）"
  "mv:04-lyric-music-video:歌词视频/MV（ClaudeAnimationBase 或 HyperFrames）"
  "data:05-data-story:数据叙事/动画图表（HyperFrames + SVG）"
  "paper:06-paper-explainer:论文讲解/会议视频（Manim + HyperFrames）"
  "handdrawn:07-hand-drawn:手绘/水彩/白板/剪纸/角色短片（ClaudeAnimationBase）"
  "meme:08-brutalist-meme:网络梗/野兽派快剪（HyperFrames）"
  "edit:09-editing-talking-head:真人素材剪辑/口播，用户自己的素材（实验中；HyperFrames）"
)
type_doc() { for t in "${TYPES[@]}"; do IFS=: read -r k f _ <<<"$t"; [ "$k" = "$1" ] && { echo "$f"; return; }; done; return 1; }
sedi() { local e=$1 f; shift; for f in "$@"; do sed "$e" "$f" > "$f.vh$$" && mv "$f.vh$$" "$f"; done; }   # in-place sed on both BSD/macOS and GNU/Linux

chrome_path() { # the Chrome render.mjs would use: CHROME_PATH, system installs, then Playwright's Chromium builds (newest first)
  local p d n
  for p in "${CHROME_PATH:-}" "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" /usr/bin/google-chrome /usr/bin/google-chrome-stable /usr/bin/chromium /usr/bin/chromium-browser; do
    [ -n "$p" ] && [ -x "$p" ] && { echo "$p"; return 0; }; done
  for d in "${PLAYWRIGHT_BROWSERS_PATH:-}" "$HOME/.cache/ms-playwright"; do
    [ -n "$d" ] && [ -d "$d" ] || continue
    for n in $(ls "$d" | sed -n 's/^chromium-\([0-9][0-9]*\)$/\1/p' | sort -rn); do
      for p in "$d/chromium-$n/chrome-linux64/chrome" "$d/chromium-$n/chrome-linux/chrome"; do [ -x "$p" ] && { echo "$p"; return 0; }; done
    done
  done
  return 1
}
webgl_probe() { # webgl_probe <chrome> <flag…>: headless, through the engine's puppeteer-core; prints the WebGL2 renderer, fails without one (20 s cap)
  local c=$1; shift
  (cd "$ROOT/engines/ClaudeAnimationBase" && VH_CHROME=$c VH_FLAGS="$*" node --input-type=module -e '
import puppeteer from "puppeteer-core";
setTimeout(() => process.exit(2), 20000).unref();
const b = await puppeteer.launch({ executablePath: process.env.VH_CHROME, headless: true, args: process.env.VH_FLAGS.split(" ").filter(Boolean) });
const r = await (await b.newPage()).evaluate(() => { const gl = document.createElement("canvas").getContext("webgl2"); if (!gl) return "";
  const x = gl.getExtension("WEBGL_debug_renderer_info"); return String(gl.getParameter(x ? x.UNMASKED_RENDERER_WEBGL : gl.RENDERER)) || "webgl2"; });
await b.close(); if (!r) process.exit(1); console.log(r);')
}
cmd_doctor() {
  local mac="" chrome r gl sb=--no-sandbox; [ "$(uname)" = Darwin ] && { mac=1; sb=""; }
  hint() { if [ -n "$mac" ]; then printf '%s\n' "$1"; else printf '%s\n' "$2"; fi; }   # $1 on macOS, $2 elsewhere
  chk() { if command -v "$1" >/dev/null 2>&1; then echo "$c_ok $1  $($2 2>&1 | head -1)"; else echo "${4:-$c_no} $1  ($3)"; fi; }   # $4: the mark when missing
  local nv; nv=$(node -v 2>/dev/null | sed 's/v//;s/\..*//' || echo 0)
  if [ "${nv:-0}" -ge 22 ] 2>/dev/null; then echo "$c_ok node  $(node -v)"; else echo "$c_no node ≥22 required (found: $(node -v 2>/dev/null || echo none))"; fi
  chk ffmpeg "ffmpeg -version" "$(hint "brew install ffmpeg" "sudo apt install ffmpeg, or your package manager")"
  chrome=$(chrome_path) || chrome=""
  [ -n "$chrome" ] && echo "$c_ok chrome  $chrome" || echo "$c_no chrome  ($(hint "install Google Chrome" "sudo apt install chromium, or npx playwright install chromium"), or set CHROME_PATH)"
  chk python3 "python3 --version" "needed for audio analysis / Manim"
  chk uv "uv --version" "$(hint "brew install uv" "curl -LsSf https://astral.sh/uv/install.sh | sh"); bin/vh tts, beats, music, sfx, qa, sheet and mix profiles run through it, Manim envs too"
  chk latex "latex --version" "optional: $(hint "MacTeX: brew install --cask mactex-no-gui" "TeX Live: sudo apt install texlive-latex-extra"), needed for Manim MathTex" "$c_wa"
  chk git "git --version" "needed by references/fetch.sh"
  [ -d "$ROOT/engines/ClaudeAnimationBase/node_modules" ] && echo "$c_ok ClaudeAnimationBase deps installed" || echo "$c_wa ClaudeAnimationBase deps missing → bin/vh setup"
  # a real headless WebGL2 context with render.mjs's default flags; Linux without a GPU only gets one in software (--soft-gl)
  if [ -z "$chrome" ] || [ ! -d "$ROOT/engines/ClaudeAnimationBase/node_modules/puppeteer-core" ]; then echo "$c_wa WebGL probe skipped (needs Chrome and the ClaudeAnimationBase deps)"
  elif r=$(webgl_probe "$chrome" $sb --ignore-gpu-blocklist "$(hint --use-angle=metal --use-gl=angle)" 2>/dev/null); then
    case "$r" in *SwiftShader*|*llvmpipe*) gl=software ;; *) gl=GPU ;; esac; echo "$c_ok WebGL ($gl)  $r"
  else
    echo "$c_wa no WebGL with the GPU flags → render with node render.mjs --soft-gl"
    if r=$(webgl_probe "$chrome" $sb --ignore-gpu-blocklist --use-angle=swiftshader --enable-unsafe-swiftshader --disable-accelerated-2d-canvas 2>/dev/null)
    then echo "$c_ok WebGL with --soft-gl  $r"; else echo "$c_wa no WebGL with --soft-gl either: WebGL scenes will not render on this machine"; fi
  fi
  # reference repos: how many of the ones references/fetch.sh lists are here (install.sh --no-refs skips them)
  local want have=0 d
  want=$(grep -cE '^(full|sparse|textonly)[[:space:]]' "$ROOT/references/fetch.sh" || true)
  for d in "$ROOT"/references/repos/*/; do [ -d "$d.git" ] && have=$((have + 1)); done
  if [ "$have" -ge "$want" ]; then echo "$c_ok references fetched ($have/$want repos, $(size_of "$ROOT/references/repos"))"
  else echo "$c_wa references: $have/$want repos fetched → bash references/fetch.sh (all $want: about 195 MB; agents read them for the case studies)"; fi
  if [ ! -f "$ROOT/LOCAL.md" ]; then echo "$c_wa no LOCAL.md → cp LOCAL.example.md LOCAL.md and fill it in"
  else   # a copied template still has its {…} placeholders
    local ph; ph=$(grep -c '{[^}]*}' "$ROOT/LOCAL.md" || true)
    if [ "${ph:-0}" -gt 0 ]; then echo "$c_wa LOCAL.md still has $ph template line(s) with {…} placeholders → fill them in (this output goes on the 已装工具 line)"
    else echo "$c_ok LOCAL.md filled in"; fi
  fi
  if [ "$(agents_body)" = "$(tail -n +4 "$ROOT/AGENTS.md" 2>/dev/null)" ]; then echo "$c_ok AGENTS.md in sync with CLAUDE.md"; else echo "$c_wa AGENTS.md out of sync → bin/vh sync-agents"; fi
  doctor_downloads
}
size_of() { # disk size of a folder, symlinks followed (a Hugging Face snapshot is all links): "202 MB", "2.0 GB"
  du -skL "$1" 2>/dev/null | awk '{m = $1 * 1024 / 1e6; if (m >= 1000) printf "%.1f GB", m / 1000; else printf "%.0f MB", m}'
}
hf_chrome() { # hf_chrome [dir]: the chrome-headless-shell `hyperframes render` uses (its ensureRenderBrowser asks for the managed one, so
  # unlike snapshot and check it never looks in ~/.cache/puppeteer): HYPERFRAMES_BROWSER_PATH (or PRODUCER_HEADLESS_SHELL_PATH), else
  # HyperFrames' own cache at the version the HyperFrames installed for dir pins (render downloads it when it is missing), else the newest there
  local p=${HYPERFRAMES_BROWSER_PATH:-${PRODUCER_HEADLESS_SHELL_PATH:-}} pin
  [ -n "$p" ] && [ -x "$p" ] && { echo "$p"; return 0; }
  pin=$(hf_pin "${1:-}") || pin=""
  shell_folder "$HOME/.cache/hyperframes/chrome/chrome-headless-shell" "$pin"
}
hf_pin() { # hf_pin <dir>: the Chrome version pinned by the HyperFrames in the nearest node_modules at or above dir, read from its dist
  # (managedChromeVersion: CHROME_VERSION, on macOS 12 MACOS_12_CHROME_VERSION); fails when there is none or it cannot be read
  local d k=CHROME_VERSION
  [ -n "${1:-}" ] && d=$(cd "$1" 2>/dev/null && pwd) || return 1
  old_mac && k=MACOS_12_CHROME_VERSION
  while [ ! -d "$d/node_modules/hyperframes" ]; do [ "$d" = / ] && return 1; d=$(dirname "$d"); done
  awk -F'"' -v k="var $k = " '$1 == k && $2 ~ /^[0-9][0-9.]*$/ { print $2; f = 1; exit } END { exit !f }' \
    "$d/node_modules/hyperframes/dist/renderSetupWorker.js" 2>/dev/null
}
old_mac() { [ "$(uname)" = Darwin ] && [ "$(uname -r | cut -d. -f1)" -lt 22 ]; }   # macOS 12 or older: HyperFrames stops Chrome at 150
shell_folder() { # shell_folder <cache dir> [version]: the folder of that chrome-headless-shell version, else (no version given) the newest;
  # only a folder with the browser in it counts (an interrupted download leaves an empty one). Folders are <platform>-<version>
  # (mac_arm-152.0.7977.30); versions compare as numbers, and on macOS 12 majors above 150 are skipped (HyperFrames does so in the puppeteer cache)
  local d=$1 cap=0 v
  [ -d "$d" ] || return 1
  old_mac && cap=150
  for v in $(ls "$d" 2>/dev/null | awk -v want="${2:-}" -v cap="$cap" '{ n = $0; sub(/^[^-]*-/, "", n); split(n, s, ".") }
      (want == "" || n == want) && !(cap && s[1] + 0 > cap) { printf "%09d%09d%09d%09d %s\n", s[1], s[2], s[3], s[4], $0 }' | sort -r | cut -d" " -f2); do
    [ -n "$(find "$d/$v" -maxdepth 3 -type f \( -name chrome-headless-shell -o -name chrome-headless-shell.exe \) 2>/dev/null | head -1)" ] && { echo "$d/$v"; return 0; }
  done
  return 1
}
doctor_downloads() { # what the first runs download on their own and how big it is on disk. The sizes are the ones in the wiki's
  # "What gets downloaded" table (Getting Started; measured on macOS arm64, 2026-10-01): keep the two in step when either changes
  echo "first-run downloads (wiki: Getting Started; mirrors behind a slow or blocked network: wiki China-Network / 国内网络):"
  local p pend="" hub model snap swatch="" voice_pkgs="" sw=""
  [ -d "$ROOT/styles/_swatch/node_modules/hyperframes" ] && sw="$ROOT/styles/_swatch"   # the HyperFrames the repo installs: the version it pins
  if p=$(hf_chrome "$sw"); then echo "$c_ok HyperFrames Chrome  $(basename "$p") · $(size_of "$p") · $(rel "$(dirname "$p")")"
  else
    [ -x "$ROOT/styles/_swatch/node_modules/.bin/hyperframes" ] && swatch="(cd styles/_swatch && npx hyperframes browser ensure)"
    echo "$c_wa HyperFrames Chrome not downloaded: the first HyperFrames render fetches the chrome-headless-shell it pins (about 200 MB on disk) into ~/.cache/hyperframes, whatever other Chrome is installed${swatch:+; now: $swatch}"
    pend="$pend Chrome 0.2 GB,"
  fi
  if command -v uv >/dev/null 2>&1; then
    if uv run -q --no-project --offline --with numpy --with scipy --with librosa --with pillow python -c "" >/dev/null 2>&1; then
      echo "$c_ok Python packages of bin/vh (numpy, scipy, librosa, pillow) are in the uv cache"
    else echo "$c_wa Python packages not cached yet: the first bin/vh beats, qa, music, sheet or storyboard run fetches numpy, scipy, librosa and pillow (about 700 MB) into the uv cache"
      pend="$pend Python packages 0.7 GB,"
    fi
  fi
  model=${QWEN_TTS_MODEL:-mlx-community/Qwen3-TTS-12Hz-0.6B-CustomVoice-8bit}
  hub=${HF_HUB_CACHE:-${HF_HOME:-$HOME/.cache/huggingface}/hub}
  snap=$(ls -d "$hub/models--${model//\//--}/snapshots/"*/ 2>/dev/null | head -1 || true)
  if [ "$(uname)" != Darwin ] || [ "$(uname -m)" != arm64 ]; then
    echo "- Qwen3-TTS (bin/vh tts's default voice) runs on Apple Silicon only (mlx-audio): use edge, gemini, minimax, dashscope or elevenlabs here"
  else
    command -v uv >/dev/null 2>&1 && ! uv run -q --no-project --offline --with mlx-audio python -c "" >/dev/null 2>&1 && voice_pkgs=1
    if [ -n "$snap" ] && [ -e "$(set -- "$snap"*.safetensors; echo "$1")" ]; then echo "$c_ok Qwen3-TTS model  $model · $(size_of "$snap")"
    else
      echo "$c_wa Qwen3-TTS model not downloaded: the first bin/vh tts with the default provider fetches $model (about 2 GB) from Hugging Face into $(rel "$hub")"
      pend="$pend Qwen3-TTS model 2 GB,"
    fi
    if [ -n "$voice_pkgs" ]; then echo "$c_wa mlx-audio and its packages (about 750 MB) are not in the uv cache yet: the first bin/vh tts with the default provider fetches them"
      pend="$pend mlx-audio 0.75 GB,"; fi
  fi
  echo "- every bin/vh new short|promo|data|meme installs its own pinned HyperFrames into the project (about 140 MB of node_modules)"
  [ -n "$pend" ] && echo "   still to come on first use:${pend%,}"
  return 0
}
agents_body() { cat "$ROOT/CLAUDE.md"; }
cmd_install_skill() { # writes a thin pointer skill whose harness path is this clone
  local which=${1:-all} dests=() d r
  case "$which" in claude) dests=("$HOME/.claude/skills") ;; codex) dests=("$HOME/.agents/skills") ;; all) dests=("$HOME/.claude/skills" "$HOME/.agents/skills") ;;
    *) echo "usage: bin/vh install-skill [claude|codex|all]   (unknown target: $which)" >&2; exit 1 ;; esac
  r=$(printf '%s\n' "$ROOT" | sed 's/[\\&#]/\\&/g')   # the clone path, escaped for the sed replacement below
  for d in "${dests[@]}"; do
    mkdir -p "$d/open-video-harness"
    sed "s#^Harness path (set by install.sh): .*#Harness path (set by install.sh): $r#" "$ROOT/skills/open-video-harness/SKILL.md" > "$d/open-video-harness/SKILL.md"
    echo "$c_ok skill → $d/open-video-harness/SKILL.md (harness: $ROOT)"
  done
  echo "   restart Claude Code / Codex so it picks up the skill; then ask for a video from any folder."
}
cmd_sync_agents() {
  { echo "<!-- AGENTS.md is generated from CLAUDE.md by \`bin/vh sync-agents\`. Edit CLAUDE.md, then re-run. -->"
    echo "<!-- Same instructions for every coding agent (Claude Code reads CLAUDE.md; Codex and others read AGENTS.md). -->"
    echo
    agents_body; } > "$ROOT/AGENTS.md"
  echo "$c_ok AGENTS.md regenerated from CLAUDE.md"
}

cmd_setup() {
  echo "→ installing ClaudeAnimationBase deps"; (cd "$ROOT/engines/ClaudeAnimationBase" && npm install --silent)
  echo "→ fetching reference repos"; "$ROOT/references/fetch.sh"
  echo "→ installing the style swatch renderer"; (cd "$ROOT/styles/_swatch" && npm ci --silent)
  [ -f "$ROOT/LOCAL.md" ] || cp "$ROOT/LOCAL.example.md" "$ROOT/LOCAL.md"
  echo "→ smoke test"
  smoke() { (cd "$ROOT/engines/ClaudeAnimationBase" && node render.mjs --sheet=0.5,4,8 --cols=3 --w=320 --out="$ROOT/.reel-smoke.jpg" "$@"); }
  if ! smoke; then   # headless Linux without a GPU gets no WebGL context unless Chrome renders it in software
    echo "   retrying with --soft-gl (software WebGL)"; smoke --soft-gl
    echo "$c_wa this machine has no usable GPU: pass --soft-gl to render.mjs here (engines/ClaudeAnimationBase/README.md)"
  fi
  rm -f "$ROOT/.reel-smoke.jpg"
  echo "$c_ok setup done. Next: bin/vh new <type> <slug>   (types: bin/vh types)"
}

cmd_types() { for t in "${TYPES[@]}"; do IFS=: read -r k f d <<<"$t"; printf "  %-10s video-types/%-32s %s\n" "$k" "$f.md" "$d"; done; }

# shellcheck disable=SC2088   # the ~ is printed, not expanded
rel() { case "$1" in "$ROOT"/*) printf '%s\n' "${1#"$ROOT"/}" ;; "$HOME"/*) printf '~/%s\n' "${1#"$HOME"/}" ;; *) printf '%s\n' "$1" ;; esac; }   # a path as printed
projects_base() { # where new projects go: --dir, else $OVH_PROJECTS, else <harness>/projects (a leading ~ is expanded)
  local b=${1:-${OVH_PROJECTS:-$ROOT/projects}}
  # shellcheck disable=SC2088   # a literal ~ in the value (quoted in a shell, or set elsewhere) means home
  case "$b" in "~") b=$HOME ;; "~/"*) b="$HOME/${b#"~/"}" ;; esac
  printf '%s\n' "$b"
}
project_dir() { # a project folder, or a name under the projects folder (the date prefix may be left out)
  local a=${1:?a project folder or name} base m n
  if [ -d "$a" ]; then (cd "$a" && pwd); return; fi
  base=$(projects_base)
  if [ -d "$base/$a" ]; then (cd "$base/$a" && pwd); return; fi
  m=$(ls -d "$base"/*-"$a" 2>/dev/null || true); n=$(printf '%s\n' "$m" | grep -c . || true)
  if [ "$n" = 1 ]; then (cd "$m" && pwd); return; fi
  if [ "$n" = 0 ]; then echo "no such project: $a (a folder, or a name under $(rel "$base"))" >&2; else echo "$a: several projects match: $(printf '%s\n' "$m" | xargs -n1 basename | tr '\n' ' ')" >&2; fi
  return 1
}
parse_styles() { # parse_styles "<a,b>": the preset names, one per line (spaces and empty items dropped). Fails with a message
  # on a name that is not a lower-case slug of a preset in styles/ (no paths, no _swatch, no glob), or when the list is empty.
  local s n=0 IFS=,
  set -f; set -- $1; set +f
  for s in "$@"; do s=$(printf '%s' "$s" | tr -d ' \t'); [ -z "$s" ] && continue
    case $s in *[!abcdefghijklmnopqrstuvwxyz0123456789-]*|-*) echo "unknown style: $s" >&2; return 1 ;; esac   # spelled out: a-z ranges follow the locale (bash 3.2) and can match capitals
    [ -f "$ROOT/styles/$s/STYLE.md" ] || { echo "unknown style: $s" >&2; return 1; }
    printf '%s\n' "$s"; n=$((n+1))
  done
  [ "$n" -gt 0 ] || { echo "no style given" >&2; return 1; }
}
attach_style() { # attach_style <project-dir> <preset>: attach a preset as a reference, not a template. Its STYLE.md and tokens.json
  # are copied to style-refs/<preset>/, the BRIEF's "Style refs" line and the note at the top of STYLE.md list it, and DECISIONS.md
  # gets a line to fill in with what it lends. Nothing is pasted into the BRIEF as instructions. Several presets can be attached;
  # attaching one again changes nothing. (Projects made before this keep their STYLE_PRESET.md; the old pasted block goes.)
  local dir=$1 style=$2 old=""
  if [ -f "$dir/STYLE_PRESET.md" ]; then   # attached the old way (before 2026-10): it was the project's base; keep it, as a reference
    old=$(sed -n '1s/.* · \([a-z0-9-]*\)$/\1/p' "$dir/STYLE_PRESET.md")
    if [ -n "$old" ]; then
      mkdir -p "$dir/style-refs/$old"; mv "$dir/STYLE_PRESET.md" "$dir/style-refs/$old/STYLE.md"
      [ -f "$dir/style.tokens.json" ] && mv "$dir/style.tokens.json" "$dir/style-refs/$old/tokens.json"
      echo "   migrated : styles/$old was this project's base (the old way); it is now a reference in style-refs/$old/ — STYLE.md's notes were written as changes to it"
    fi
  fi
  [ -f "$dir/DECISIONS.md" ] || cp "$ROOT/templates/DECISIONS.md" "$dir/DECISIONS.md"
  mkdir -p "$dir/style-refs/$style"
  cp "$ROOT/styles/$style/STYLE.md" "$dir/style-refs/$style/STYLE.md"; cp "$ROOT/styles/$style/tokens.json" "$dir/style-refs/$style/tokens.json"
  python3 - "$dir/BRIEF.md" "$dir/STYLE.md" "$dir/DECISIONS.md" "$style" "$old" <<'PY'
import datetime, os, re, sys
brief, style, dec, slug, old = sys.argv[1:6]
b = open(brief).read()
b = re.sub(r"\n\n## Style preset: [^\n]*\n\n```text\n.*?```\n", "", b, flags=re.S)   # pasted by bin/vh before 2026-10: an instruction block
m = re.search(r"^- Style refs \(repo presets\): (.*)$", b, re.M)
refs = re.findall(r"styles/([a-z0-9-]+)", m.group(1).split("<!--")[0]) if m else []
for r in ([old] if old else []) + [slug]:
    if r not in refs: refs.append(r)
line = "- Style refs (repo presets): " + ", ".join(f"`styles/{r}`" for r in refs) + "  <!-- 参考，不是规定：副本在 style-refs/，借了什么记进 DECISIONS.md，和它们不一样不用解释 -->"
if m: b = b[:m.start()] + line + b[m.end():]
elif "\n## Style\n" in b: b = b.replace("\n## Style\n", "\n## Style\n" + line + "\n", 1)
else: b += "\n" + line + "\n"
open(brief, "w").write(b)
s = open(style).read()
s = re.sub(r"\A> 本项目以风格预设 `styles/[^`]*` 为底：[^\n]*\n\n", "", s)
s = re.sub(r"\A> 参考的风格预设：[^\n]*\n\n", "", s)
note = "> 参考的风格预设：" + "、".join(f"`styles/{r}`" for r in refs) + "（副本在 `style-refs/`）。只是参考：借了什么写进 `DECISIONS.md`，和它们不一样不用解释；本片的风格从立意来，写在下面。\n\n"
open(style, "w").write(note + s)
d = open(dec).read()
for r in ([old] if old else []) + [slug]:
    if f"风格参考 · `styles/{r}`" not in d:
        d = d.rstrip("\n") + f"\n- {datetime.date.today():%Y-%m-%d} 风格参考 · `styles/{r}` — 借了：{{色板 / 字体 / 转场 / 声音 / 质感，写具体；没借就删掉这一行}}\n"
open(dec, "w").write(d)
PY
  return 0
}

cmd_new() {
  [ $# -ge 2 ] || { echo "usage: bin/vh new <type> <slug> [--style <preset[,preset]>] [--effort quick|standard|studio] [--aspect 16:9|9:16|1:1|4:5|3:4] [--watch phone|feed|desktop] [--res 1080p|4k] [--lang zh|en] [--engine canvas-film] [--dir <folder>]"; cmd_types; exit 1; }
  local type=$1 slug=$2 doc style="" effort="" aspect="" res="" parent="" wh="" watch="" outres="" lang="" frameh="" engine=""; doc=$(type_doc "$type") || { echo "unknown type: $type"; cmd_types; exit 1; }
  shift 2
  while [ $# -gt 0 ]; do case "$1" in
    --style)  style=${2:?--style needs a preset or a comma list (bin/vh style list)}; shift 2 ;;
    --effort) effort=${2:?--effort needs quick, standard or studio}; shift 2 ;;
    --aspect) aspect=${2:?--aspect needs 16:9, 9:16, 1:1, 4:5 or 3:4}; shift 2 ;;
    --dir)    parent=${2:?--dir needs a folder: the project goes in <folder>/<date>-<slug>}; shift 2 ;;
    --watch)  watch=${2:?--watch needs phone, feed or desktop}; shift 2 ;;
    --res)    outres=${2:?--res needs 1080p or 4k}; shift 2 ;;
    --lang)   lang=${2:?--lang needs zh or en}; shift 2 ;;
    --engine) engine=${2:?--engine needs canvas-film (engines/canvas-film/README.md)}; shift 2 ;;
    *) echo "unknown option: $1"; exit 1 ;;
  esac; done
  case "$lang" in ""|zh|en) ;; *) echo "unknown --lang: $lang (zh | en: the language of the review pages, from the user's first request)"; exit 1 ;; esac
  case "$engine" in ""|canvas-film) ;; *) echo "unknown --engine: $engine (canvas-film; leave it out for the type's own engine)"; exit 1 ;; esac
  local s styles=""; if [ -n "$style" ]; then styles=$(parse_styles "$style") || { cmd_style list; exit 1; }; fi
  case "${effort:-standard}" in quick|standard|studio) ;; *) echo "unknown effort: $effort (quick | standard | studio)"; exit 1 ;; esac
  case "$watch" in ""|phone|feed|desktop) ;; *) echo "unknown --watch: $watch (phone: a vertical phone · feed: landscape in a phone feed, not rotated · desktop: a computer, or a phone turned sideways)"; exit 1 ;; esac
  case "$outres" in ""|1080p) ;; 4k|4K|2160p) outres=4k ;; *) echo "unknown --res: $outres (1080p | 4k)"; exit 1 ;; esac
  if [ "$outres" = 4k ] && [ -z "$engine" ]; then case "$type" in handdrawn|mv) echo "--res 4k: the hand-drawn engine (ClaudeAnimationBase) has no 4K output yet; use 1080p, or another engine (engines/README.md)"; exit 1 ;; esac; fi
  if [ "$engine" = canvas-film ]; then   # the canvas engine draws 16:9 whatever the type
    case "$aspect" in ""|16:9|landscape) res=landscape ;;
      *) echo "--aspect: the canvas-film engine draws 16:9 (1920x1080); another frame means editing its template (engines/canvas-film/README.md, 局限)"; exit 1 ;; esac
  elif [ -n "$aspect" ]; then   # HyperFrames types scaffold at any of these; the other engines set their size themselves
    case "$aspect" in 16:9|landscape) res=landscape; aspect=16:9 ;; 9:16|portrait) res=portrait; aspect=9:16 ;; 1:1|square) res=square; aspect=1:1 ;;
      4:5) res=portrait; frameh=1350 ;; 3:4) res=portrait; frameh=1440 ;;   # feed posts (Instagram, 小红书): the portrait scaffold, shorter
      *) echo "unknown aspect: $aspect (16:9 | 9:16 | 1:1 | 4:5 | 3:4)"; exit 1 ;; esac
    case "$type" in short|promo|data|meme) ;;
      math|paper) echo "--aspect: Manim renders 16:9 here; for a vertical film set pixel_width/pixel_height in manim.cfg (engines/README.md, Manim 竖屏)"; exit 1 ;;
      handdrawn|mv) echo "--aspect: the hand-drawn engine (ClaudeAnimationBase) draws 1920x1080 only"; exit 1 ;;
      *) echo "--aspect works for short, promo, data and meme (HyperFrames); $type follows its footage (video-types/09-editing-talking-head.md)"; exit 1 ;; esac
    if [ -n "$frameh" ] && [ "$outres" = 4k ]; then echo "--res 4k: HyperFrames has no 4K preset for $aspect; it renders 1080x$frameh only"; exit 1; fi
  fi
  case "$type" in short) res=${res:-portrait} ;; promo|data|meme) res=${res:-landscape} ;; esac
  case "$res" in portrait) wh=1080x${frameh:-1920} ;; square) wh=1080x1080 ;; landscape) wh=1920x1080 ;; esac
  [ -n "$wh" ] || case "$type" in math|paper|handdrawn|mv) wh=1920x1080 ;; edit) wh=1080x1920 ;; esac   # the other engines' frame (edit: follow the footage)
  local res4k=""; [ "$outres" = 4k ] && res4k="1080p, 4k"   # drafts and the reference cut stay 1080p
  if [ -z "$watch" ]; then   # where it is mostly watched sets the text-size floor (playbook/03 §4); the frame gives the default
    case "$res:$type" in portrait:*|square:*|:edit) watch=phone ;; landscape:meme) watch=feed ;; *) watch=desktop ;; esac
  fi
  local frame=$res; case "$type" in math|paper) frame=${frame:-landscape} ;; esac   # Manim renders landscape
  case "$watch:$frame" in   # a frame and a target that contradict each other (the feed floor is for a 1920-wide frame)
    feed:portrait|feed:square) echo "--watch feed is for a landscape film shown in a phone feed; a ${aspect:-vertical} frame is already --watch phone"; exit 1 ;;
    phone:landscape) echo "--watch phone is for a vertical or square frame; a landscape film watched on a phone is --watch feed (in a feed, not rotated) or desktop (turned sideways)"; exit 1 ;;
  esac
  local base dir; base=$(projects_base "$parent")
  mkdir -p "$base" || { echo "cannot create $base"; exit 1; }
  base=$(cd "$base" && pwd); dir="$base/$(date +%F)-$slug"
  [ -e "$dir" ] && { echo "$dir already exists"; exit 1; }
  # a step that fails from here on must not leave a half-built dir behind (a retry would say "already exists")
  NEW_DIR=$dir; trap 'rm -rf "$NEW_DIR"; echo "$c_no removed the unfinished $(rel "$NEW_DIR")" >&2' EXIT
  if [ "$engine" = canvas-film ]; then   # a static page and its scripts: nothing to install (one command a line, so a failed copy stops here)
    mkdir -p "$dir"
    rsync -a --exclude out "$ROOT/engines/canvas-film/template/" "$dir/"
    cp "$ROOT/engines/canvas-film/README.md" "$dir/ENGINE_README.md"
  elif [ "$type" = handdrawn ] || [ "$type" = mv ]; then
    rsync -a --exclude node_modules --exclude out "$ROOT/engines/ClaudeAnimationBase/" "$dir/"
    mv "$dir/README.md" "$dir/ENGINE_README.md"   # the engine's own readme; project docs are BRIEF/STORYBOARD/…
    (cd "$dir" && npm install --silent)
  else mkdir -p "$dir"; fi
  mkdir -p "$dir/audio" "$dir/assets" "$dir/out/check"
  for f in BRIEF STYLE STORYBOARD REVIEW DECISIONS NOTES LESSONS TASTE_CHECKLIST; do cp "$ROOT/templates/$f.md" "$dir/$f.md"; done
  # the type doc is named, not pasted: its Prompt 增量块 is read after the concept (CLAUDE.md step 4); the marker is
  # what tools/vhdraw.py reads to find the type
  python3 - "$doc.md" "$dir/BRIEF.md" <<'PY'
import sys
name, brief = sys.argv[1], sys.argv[2]
b = open(brief).read().replace("- Type doc: {type doc}", f"- Type doc: `video-types/{name}`", 1)
open(brief, "w").write(b.rstrip("\n") + f"\n<!-- from {name} -->\n")
PY
  [ -n "$wh" ] && sedi "s/^- Output: {W}x{H},/- Output: $wh,/" "$dir/BRIEF.md"
  sedi "s/^- Watch on: {watch}/- Watch on: $watch/; s/^- Resolution: {res}/- Resolution: ${res4k:-1080p}/; s/^- Review language: zh /- Review language: ${lang:-zh} /" "$dir/BRIEF.md"
  local nframe='类型文档 Prompt 增量块写的画幅，以及按它算的尺寸（安全框、每行字数、字号），以这一行为准按新画幅重算。'
  if [ "$engine" = canvas-film ]; then   # 16:9 is these types' own frame except short and edit
    case "$type" in short|edit) printf '\n> **画幅 16:9（%s，canvas-film 引擎）**：%s\n' "$wh" "$nframe" >> "$dir/BRIEF.md" ;; esac
  else
    case "$type:$res:$frameh" in short:portrait:|promo:landscape:|data:landscape:|meme:landscape:|*::) ;;   # the type's own frame: nothing to say
      *) printf '\n> **画幅 %s（%s，建项目时用 --aspect 选定）**：%s\n' "$aspect" "$wh" "$nframe" >> "$dir/BRIEF.md" ;;
    esac
  fi
  if [ "$engine" = canvas-film ]; then
    sedi 's|^- Engine: {[^}]*}|- Engine: canvas-film (ENGINE_README.md)|' "$dir/BRIEF.md"
    python3 - "$dir/BRIEF.md" <<'PY'
import sys
p = sys.argv[1]; s = open(p).read()
note = ("> **本项目用 canvas-film 引擎**（`ENGINE_README.md`，和 `engines/canvas-film/README.md` 是同一份）：镜头、字幕、章节的时间写成挂在旁白字上的 cue，"
        "`src/50-shots.js` 是这支片子，其余 `src/` 是引擎。现在的 `src/50-shots.js` 和 `audio/timeline.zh.json` 是一支示例片，开工时一起换掉。\n"
        "> 取帧 `bin/vh frames <项目> --at …`，查字 `bin/vh textcheck <项目>`，成片画面 `bin/vh render <项目>`。\n\n")
open(p, "w").write(s.replace("# BRIEF\n", "# BRIEF\n\n" + note, 1))
PY
    echo "   engine   : canvas-film (ENGINE_README.md) · the example film draws as it is: bin/vh frames $(rel "$dir") --at 1,5,9"
  else
    case "$type" in
      short|promo|data|meme) if [ -n "$frameh" ]; then cmd_hf_init "$dir" "$aspect" || true; else cmd_hf_init "$dir" "$res" || true; fi ;;
      math|paper) echo "   engine   : Manim → cd $(rel "$dir") && uv init --bare --python 3.12 && uv add manim   (see engines/README.md)" ;;
      edit) echo "   engine   : HyperFrames → bin/vh hf-init $(rel "$dir") portrait   (or landscape; see video-types/09-editing-talking-head.md)" ;;
    esac
  fi
  if [ -z "$engine" ] && { [ "$type" = handdrawn ] || [ "$type" = mv ]; }; then
    python3 - "$dir/BRIEF.md" <<'PY'
import sys
p = sys.argv[1]; s = open(p).read()
note = ("> **本项目用 ClaudeAnimationBase：`ANIMATION_GUIDE.md` 的规则优先于 playbook/03 的运动默认值和 TASTE_CHECKLIST #12。**\n"
        "> 卡通语域下，预备动作、挤压拉伸、overshoot、表情 take 和踩拍的 idle 动作都是必需的；不写字的影片可以删掉 Style 里的 Type 一行和 Text rules 一节。\n"
        "> 成片输出为 `node render.mjs --clip --out=out/final.mp4`（长片用 `--frames` 再 `--encode --out=out/final.mp4`）。\n\n")
open(p, "w").write(s.replace("# BRIEF\n", "# BRIEF\n\n" + note, 1))
PY
  fi
  if [ -n "$effort" ]; then
    sedi "s/^- Effort: standard /- Effort: $effort /" "$dir/BRIEF.md"
    [ "$effort" = quick ] && printf '\n> **Effort: quick**（%s，建项目时选定）：按 CLAUDE.md"努力程度"，人工关卡豁免，直接出片；人点名要拍板的事照样停（导演模式）；需求有歧义时最多问 1 个问题。\n' "$(date +%F)" >> "$dir/REVIEW.md"
  fi
  case "$type" in   # the type's usual reading pace (the BRIEF's Pace comment); the BRIEF line can change it
    math|paper) sedi "s/^- Pace: normal /- Pace: relaxed /" "$dir/BRIEF.md" ;;
    meme) sedi "s/^- Pace: normal /- Pace: brisk /" "$dir/BRIEF.md" ;;
  esac
  for s in $styles; do attach_style "$dir" "$s"; done   # presets as references: copies in style-refs/, listed in BRIEF, a DECISIONS line
  trap - EXIT
  echo "$c_ok created $(rel "$dir")"
  echo "   type doc : video-types/$doc.md"
  local fdesc="${frameh:+$aspect, }$res"   # empty for the types whose engine is not scaffolded here (math, paper, handdrawn, mv, edit)
  [ -n "$wh" ] && echo "   frame    : $wh${fdesc:+ ($fdesc)}"
  echo "   watch on : $watch · ${outres:-1080p}  (text-size floor and readability check: playbook/03 §4)"
  [ -n "$styles" ] && echo "   style ref: $(printf '%s\n' $styles | sed 's|^|styles/|' | paste -sd, - | sed 's/,/, /g') (copies in style-refs/; references, not rules: note in DECISIONS.md what each lends)"
  echo "   effort   : ${effort:-standard}  (bin/vh effort ${effort:-standard} shows what that means)"
  echo "   review in: ${lang:-zh}  (the review pages' language: --lang en for an English-speaking user)"
  echo "   next     : open Claude Code in the repo root and say what the video is about;"
  case "${effort:-standard}" in
    quick) echo "              the agent fills $(rel "$dir")/BRIEF.md and renders straight through; it stops only for what you say you'll decide." ;;
    studio) echo "              the agent fills $(rel "$dir")/BRIEF.md and STORYBOARD.md and stops for your review (concept and outline, storyboard, first draft)"
            echo "              in the review desk (bin/vh desk): tick, comment and submit in the page, and it carries on." ;;
    *) echo "              the agent fills $(rel "$dir")/BRIEF.md and STORYBOARD.md and stops for your review (concept and outline, storyboard, first draft)." ;;
  esac
}

cmd_effort() { # the effort levels: the rules from CLAUDE.md's 努力程度, the table from playbook/01's; with a level, only that column
  local lvl=${1:-} sect='/^## 努力程度/{on=1} on && /^## / && !/努力程度/{exit} on'
  case "$lvl" in ""|quick|standard|studio) ;; *) echo "usage: bin/vh effort [quick|standard|studio]"; exit 1 ;; esac
  { awk "$sect" "$ROOT/CLAUDE.md"; echo "@@table@@"; awk "$sect" "$ROOT/playbook/01-pipeline.md"; } | python3 -c '
import sys
lvl = sys.argv[1]; rules, table = sys.stdin.read().split("@@table@@\n", 1)
if not lvl: print(rules.rstrip() + "\n\n" + table.rstrip()); sys.exit()
col = {"quick": 2, "standard": 3, "studio": 4}[lvl]
rows = [l for l in table.splitlines() if l.startswith("| ") and not l.startswith("|---") and not l.startswith("| 旋钮")]
if not rows: sys.exit("bin/vh effort: no table under ## 努力程度 in playbook/01-pipeline.md")
for l in rows:
    c = [x.strip() for x in l.strip("|").split("|")]
    v = c[col-1]
    if v.startswith("同左"):   # "same as standard" + extras → spell it out when one level is shown alone
        rest = v[2:].lstrip("，,；; ")
        v = c[2] + ((" " if rest.startswith("+") else "；") + rest if rest else "")
    print(f"  {c[0]:<10} {v}")
floors = False
for l in rules.splitlines():
    if l.startswith("- **评审有上限") and lvl != "quick": print("\n" + l[2:])   # quick has no review rounds
    elif l.startswith("**任何档位都不降"): print("\n" + l); floors = True
    elif floors and l.startswith("- "): print("  " + l)
    elif floors and not l.strip(): floors = False
' "$lvl"
}

cmd_readcheck() { # a canvas-film project (film.html, or the folder): its texts exist once the page runs, so they are written
  # first (tools/film/texts.mjs) and readcheck reads that file in its place
  local a args=() proj b
  for a in "$@"; do
    if [ -z "${proj:-}" ] && { { [ -d "$a" ] && [ -f "$a/film.html" ]; } || [ "$(basename -- "$a")" = film.html ]; }; then
      proj=$a; [ -d "$a" ] || proj=$(dirname -- "$a")
      b=$(film_browser readcheck "$proj") || exit 2
      node "$ROOT/tools/film/texts.mjs" --browser "$b" "$proj" --out "$proj/out/texts.json" || exit $?
      a="$proj/out/texts.json"
    fi
    args+=("$a")
  done
  python3 "$ROOT/tools/readcheck.py" ${args[@]+"${args[@]}"}
}
hf_shell() { # hf_shell [dir]: a chrome-headless-shell binary: the one `hyperframes render` uses for dir (hf_chrome), else the newest one
  # in ~/.cache/puppeteer (what snapshot and check take first); hf_chrome and shell_folder print a version folder, this the binary in it
  local p
  p=$(hf_chrome "${1:-}") || p=$(shell_folder "$HOME/.cache/puppeteer/chrome-headless-shell") || return 1
  [ -f "$p" ] && [ -x "$p" ] && { echo "$p"; return 0; }
  p=$(find "$p" -maxdepth 3 -type f \( -name chrome-headless-shell -o -name chrome-headless-shell.exe \) 2>/dev/null | head -1)
  [ -n "$p" ] && echo "$p"
}
cmd_textcheck() { # canvas text covered or too faint (tools/textcheck/textcheck.mjs). The browser: CHROME_PATH, else the chrome-headless-shell
  # `hyperframes render` uses for this project (what renders the film), else the newest one in ~/.cache/puppeteer (what snapshot and check
  # take first), then Chrome or Chromium, with a line saying it is not the film's; no npm package needed
  [ $# -gt 0 ] || { cmd_usage textcheck; exit 1; }
  local b=${CHROME_PATH:-} d
  if [ -z "$b" ] || [ ! -x "$b" ]; then
    d=$(arg_dir "$@")
    b=$(hf_shell "$d") || b=$(chrome_path) || { echo "$c_no bin/vh textcheck needs a headless Chrome: npx hyperframes browser ensure (in a HyperFrames project), install Chrome or Chromium, or set CHROME_PATH" >&2; exit 2; }
    hf_chrome "$d" >/dev/null || echo "$c_wa not the chrome-headless-shell hyperframes render uses for this project, so text can lay out a little differently in the film (npx hyperframes browser ensure there fetches it)" >&2
  fi
  exec node "$ROOT/tools/textcheck/textcheck.mjs" --browser "$b" "$@"
}
cmd_frames() { cmd_film_tool frames "$@"; }   # frames drawn from a page through the page contract (tools/film/frames.mjs)
cmd_bake() { cmd_film_tool bake "$@"; }       # the static scene frozen into one PNG (tools/film/bake.mjs) — the pre-computed shared asset
cmd_fonts() { # check: through the page contract (tools/film/fonts.mjs); list and subset read font files (tools/fonts.py, fontTools)
  case "${1:-}" in
    check) shift; cmd_film_tool fonts "$@" ;;
    list|subset) command -v uv >/dev/null 2>&1 || { echo "$c_no bin/vh fonts $1 needs uv (it brings fontTools): bin/vh doctor says how to install it" >&2; exit 2; }
      uv run -q --no-project --with fonttools --with brotli python "$ROOT/tools/fonts.py" "$@" ;;
    *) cmd_usage fonts; exit 1 ;;
  esac
}
arg_dir() { # the folder of the project or page among a tool's arguments: the first that is neither an option nor an option's
  # value (the options listed take none), a file's folder; "." when there is none, so --out o <project> finds the project too
  local a skip=0
  for a in "$@"; do
    if [ $skip = 1 ]; then skip=0; continue; fi
    case $a in
      --soft-gl|--real-clock|--png|--force|--save|--strict|--in-place|--keep|--*=*) ;;
      -*) skip=1 ;;
      *) if [ -d "$a" ]; then echo "$a"; else case $a in */*) echo "${a%/*}" ;; *) echo . ;; esac; fi; return 0 ;;
    esac
  done
  echo .
}
film_browser() { # film_browser <command> [dir]: the browser the page-contract tools draw with, as for textcheck (the one hyperframes
  # render uses for dir, else the newest in ~/.cache/puppeteer, else Chrome or Chromium); the command is for the message
  local b=${CHROME_PATH:-}
  if [ -z "$b" ] || [ ! -x "$b" ]; then
    b=$(hf_shell "${2:-}") || b=$(chrome_path) || { echo "$c_no bin/vh $1 needs a headless Chrome: npx hyperframes browser ensure (in a HyperFrames project), install Chrome or Chromium, or set CHROME_PATH" >&2; return 1; }
  fi
  echo "$b"
}
cmd_film_tool() { # $1: frames | bake | render | determinism | cues | fonts | patch (tools/film/<it>.mjs)
  local tool=$1 b; shift
  [ $# -gt 0 ] || { cmd_usage "$tool"; exit 1; }
  # a whole standard or studio film is made after gate ①: its decision on record (CLAUDE.md 关卡); a part (look-dev, a
  # test, the frames bin/vh patch draws again) is not held up
  if [ "$tool" = render ]; then
    case " $* " in *" --range"*|*" --frames"*|*" -h "*|*" --help "*) ;;
      *) local g grc=0; g=$(python3 "$ROOT/tools/gatecheck.py" "$(arg_dir "$@")" --for render) || grc=$?
         if [ "$grc" = 1 ]; then printf '%s\n' "$g" | sed "1s/^/$c_no /" >&2; echo "   (a part of the film renders before that: --range a:b)" >&2; exit 1; fi ;;
    esac
  fi
  b=$(film_browser "$tool" "$(arg_dir "$@")") || exit 2
  exec node "$ROOT/tools/film/$tool.mjs" --browser "$b" "$@"
}
cmd_storyboard() { [ $# -gt 0 ] || { echo "usage: bin/vh storyboard <project> [--video v.mp4 | --snapshot] [--unsure S02,S04] [--per 6]   (-h: the shots.json schema)"; exit 1; }
  uv run -q --no-project --with pillow python "$ROOT/tools/storyboard.py" "$@"; }
cmd_rhythm() { [ $# -gt 0 ] || { echo "usage: bin/vh rhythm <project> [--segment NAME | --from s --to s] [--max s] [--out file.png]"; exit 1; }
  uv run -q --no-project --with pillow python "$ROOT/tools/rhythm.py" "$@"; }
cmd_cover_preview() { [ $# -gt 0 ] || { echo "usage: bin/vh cover-preview <image> [more…] [--text-px N] [--out file.png|folder]"; exit 1; }
  uv run -q --no-project --with pillow --with numpy --with scipy python "$ROOT/tools/cover_preview.py" "$@"; }
cmd_review() { python3 "$ROOT/tools/review.py" "$@"; }
cmd_desk() { [ $# -gt 0 ] || { cmd_usage desk; exit 1; }   # stdlib only: no uv, works offline; exec, so stopping
  exec python3 "$ROOT/tools/desk/desk.py" "$@"; }            # a backgrounded bin/vh desk stops the server itself

swatch_deps() { # the swatch renderer's pinned HyperFrames (render.sh and determinism.sh do not install it themselves);
  # $1 = the slug or scene folder: a Blender scene (swatch.py and no swatch.js) does not need it
  local d="$ROOT/styles/${1:-}"; case "${1:-}" in */*) d=$1 ;; esac
  [ -f "$d/swatch.py" ] && [ ! -f "$d/swatch.js" ] && return 0
  [ -x "$ROOT/styles/_swatch/node_modules/.bin/hyperframes" ] || (cd "$ROOT/styles/_swatch" && npm ci --silent)
}
cmd_style() { # style library: styles/<preset>/{STYLE.md,tokens.json,swatch.js,media/}; renderer in styles/_swatch
  local sw="$ROOT/styles/_swatch"
  case "${1:-list}" in
    list) python3 - "$ROOT/styles" <<'PY'
import json, pathlib, sys
for d in sorted(pathlib.Path(sys.argv[1]).iterdir()):
    t = d / "tokens.json"
    if d.name.startswith("_") or not t.exists(): continue
    j = json.loads(t.read_text())
    has = "swatch" if (d / "media" / "swatch.mp4").exists() else "—"
    print(f"  {d.name:22} {j.get('family',''):13} {j.get('name',{}).get('zh',''):14} {has}")
PY
      ;;
    gallery) shift; uv run -q --no-project --with pillow python "$sw/gallery.py" "$@" ;;
    check) shift; case "${1:-}" in -h|--help) echo "usage: bin/vh style check <preset> [workers_b=3]   frames from 1 and N render workers must match (styles/_swatch/determinism.sh)"; return ;; esac
      swatch_deps "${1:-}"; "$sw/determinism.sh" "$@" ;;
    compare) shift; [ $# -gt 0 ] || { echo "usage: bin/vh style compare a,b,c [--frame t] [--out file.png]"; exit 1; }
      uv run -q --no-project --with pillow python "$ROOT/tools/style_compare.py" "$@" ;;
    apply) shift; [ $# -eq 2 ] || { echo "usage: bin/vh style apply <preset[,preset]> <project>   (bin/vh style list shows the presets)"; exit 1; }
      local s styles; styles=$(parse_styles "$1") || { cmd_style list; exit 1; }
      local dir; dir=$(project_dir "$2") || exit 1
      [ -f "$dir/BRIEF.md" ] && [ -f "$dir/STYLE.md" ] || { echo "$(rel "$dir") has no BRIEF.md and STYLE.md: not a bin/vh project"; exit 1; }
      for s in $styles; do attach_style "$dir" "$s"
        echo "$c_ok styles/$s attached to $(rel "$dir") as a reference (style-refs/$s/, BRIEF Style refs, a DECISIONS line to fill in)"; done ;;
    *) swatch_deps "$1"; exec "$sw/render.sh" "$@" ;;
  esac
}

cmd_hf_init() { # HyperFrames 0.8.x `init` installs skills GLOBALLY (~/.claude/skills) unless HYPERFRAMES_SKIP_SKILLS=1
  local dir=${1:?usage: bin/vh hf-init <project-dir> [landscape|portrait|square|4:5|3:4]} res=${2:-landscape} tmp f b font="" h=""
  local frame=$res   # as given, for the messages (res becomes the preset)
  case "$res" in   # the composition's frame; HyperFrames renders 4K from it with render --resolution 4k
    landscape|16:9) res=landscape ;; portrait|9:16) res=portrait ;; square|1:1) res=square ;;
    4:5) res=portrait; h=1350 ;; 3:4) res=portrait; h=1440 ;;
    *-4k|*-4K|4k|4K|*2160p) echo "$c_no hf-init $res: 4K is a render flag (render --resolution 4k), not a frame. Scaffold landscape, portrait or square and write the composition at 1080p, so the size floors hold"; return 1 ;;
    *) echo "$c_no hf-init: unknown frame $res (landscape | portrait | square | 4:5 | 3:4)"; return 1 ;;
  esac
  [ -d "$dir" ] || { echo "no such project: $dir"; return 1; }
  if [ -f "$dir/hyperframes.json" ]; then
    echo "$c_ok HyperFrames already initialised in ${dir#$ROOT/}"
    [ -z "$h" ] || echo "$c_wa nothing was changed for $frame: set the viewport, the CSS height and data-height in index.html to $h by hand"
    return 0
  fi
  echo "→ scaffolding HyperFrames ${HYPERFRAMES_VERSION:-0.8.82} (${h:+1080x$h from }$res) — pinned, no global skills, telemetry off"
  tmp=$(mktemp -d)
  if ! (cd "$tmp" && HYPERFRAMES_SKIP_SKILLS=1 DO_NOT_TRACK=1 npx --yes "hyperframes@${HYPERFRAMES_VERSION:-0.8.82}" init hf --non-interactive --resolution "$res" >/dev/null 2>&1); then
    echo "$c_wa hyperframes init failed (offline?) — retry later: bin/vh hf-init ${dir#$ROOT/} $frame"; rm -rf "$tmp"; return 1; fi
  # the scaffold's Inter has no @font-face, so every render, snapshot and check requests it from Google Fonts and hangs where
  # that is blocked: declare system fonts through local() instead, as styles/_swatch/fonts.css does (in the scaffold, before the copy)
  python3 - "$tmp/hf/index.html" <<'PY' && font=local
import re, sys
p = sys.argv[1]; s = open(p, encoding="utf-8").read()
faces = """\
      /* Local fonts only. At render time HyperFrames fetches a font from Google Fonts for every family without an @font-face
         (it hangs where that is blocked), lint-clean names like Arial or Menlo included, and for a stack that starts with a
         generic family (it puts Inter first). Declare each font you add like these; more macOS faces: styles/_swatch/fonts.css */
      @font-face { font-family: "Helvetica Neue"; src: local("HelveticaNeue"), local("Helvetica Neue"); font-weight: 400; }
      @font-face { font-family: "Helvetica Neue"; src: local("HelveticaNeue-Bold"), local("Helvetica Neue Bold"); font-weight: 700; }
      @font-face { font-family: "Liberation Sans"; src: local("LiberationSans"), local("Liberation Sans"); font-weight: 400; }
      @font-face { font-family: "Liberation Sans"; src: local("LiberationSans-Bold"), local("Liberation Sans Bold"); font-weight: 700; }
      @font-face { font-family: "DejaVu Sans"; src: local("DejaVuSans"), local("DejaVu Sans"); font-weight: 400; }
      @font-face { font-family: "DejaVu Sans"; src: local("DejaVuSans-Bold"), local("DejaVu Sans Bold"); font-weight: 700; }
"""
s, n = re.subn(r"font-family: Inter\b[^;]*;", 'font-family: "Helvetica Neue", "Liberation Sans", "DejaVu Sans", sans-serif;', s)
if not n or "<style>\n" not in s: sys.exit(1)
open(p, "w", encoding="utf-8").write(s.replace("<style>\n", "<style>\n" + faces, 1))
PY
  if [ -n "$h" ]; then   # 4:5 and 3:4 have no preset: the portrait scaffold, its height set in the three places it is written
    python3 - "$tmp/hf/index.html" "$h" <<'PY' || echo "$c_wa could not set the composition to 1080x$h: set the viewport, the CSS height and data-height in index.html by hand"
import sys
p, h = sys.argv[1], sys.argv[2]; s = open(p, encoding="utf-8").read()
t = s.replace("height=1920", f"height={h}").replace("height: 1920px", f"height: {h}px").replace('data-height="1920"', f'data-height="{h}"')
if "1920" in t or t.count(h) < 3: sys.exit(1)
open(p, "w", encoding="utf-8").write(t)
PY
  fi
  [ -e "$dir/index.html" ] && font=own   # the project's own index.html stays as it is (nothing below replaces an existing file)
  shopt -s dotglob
  for f in "$tmp"/hf/*; do b=$(basename "$f")
    case "$b" in CLAUDE.md|AGENTS.md|.claude|.agents|README.md|.git) continue ;; esac   # keep the harness in charge of routing
    [ -e "$dir/$b" ] || cp -R "$f" "$dir/"
  done
  shopt -u dotglob; rm -rf "$tmp"
  (cd "$dir" && npm i -D --save-exact --silent --no-fund --no-audit "hyperframes@${HYPERFRAMES_VERSION:-0.8.82}" >/dev/null 2>&1) || echo "$c_wa could not pin hyperframes locally (offline?)"
  # the scaffold loads GSAP from a CDN; an offline render then hangs silently, so vend it locally (same pinned version)
  local gv; gv=$(grep -o 'cdn.jsdelivr.net/npm/gsap@[0-9.]*' "$dir"/*.html 2>/dev/null | head -1 | sed 's/.*gsap@//') || true
  if [ -n "$gv" ] && (cd "$dir" && npm i -D --save-exact --silent --no-fund --no-audit "gsap@$gv" >/dev/null 2>&1); then
    sedi "s#https://cdn.jsdelivr.net/npm/gsap@$gv/dist/gsap.min.js#node_modules/gsap/dist/gsap.min.js#g" "$dir"/*.html
    echo "   gsap     : $gv vendored locally (node_modules/gsap), no CDN at render time"
  fi
  case $font in
    local) echo "   font     : Helvetica Neue (macOS), Liberation Sans or DejaVu Sans (Linux) through local(), no Google Fonts at render time" ;;
    own) echo "$c_wa the project's own index.html was kept as it is: its fonts${h:+ and its height (set the viewport, the CSS height and data-height to $h)} are yours to check" ;;
    "") echo "$c_wa the scaffold's font was not rewritten: give each font in index.html a local() @font-face before rendering, or the render fetches it from Google Fonts" ;;
  esac
  grep -lE 'https?://(cdn\.|unpkg\.com|cdnjs\.)' "$dir"/*.html 2>/dev/null | sed "s#^#$c_wa still loads from a CDN (vendor it before rendering): #" || true
  echo "$c_ok HyperFrames scaffolded into ${dir#$ROOT/} (index.html, hyperframes.json …). Always prefix npx hyperframes with HYPERFRAMES_SKIP_SKILLS=1."
}
project_of() { # nearest ancestor of $1 that contains BRIEF.md (a project), else empty
  local d; d=$(cd "$(dirname "$1")" && pwd)
  while [ "$d" != "/" ]; do [ -f "$d/BRIEF.md" ] && { echo "$d"; return; }; d=$(dirname "$d"); done
}
cmd_sheet() {
  local v=${1:?usage: bin/vh sheet <video> [cols] [fps] [out]} cols=${2:-6} fps=${3:-1} name base why="install uv"; name=$(basename "$v"); name=${name%.*}
  base=$(project_of "$v"); [ -n "$base" ] || base="$(cd "$(dirname "$v")" && pwd)"
  local out=${4:-"$base/out/check/${name}-sheet-$(date +%H%M%S).png"}; mkdir -p "$(dirname "$out")"
  if command -v uv >/dev/null 2>&1; then   # timestamped tiles (ffmpeg builds often lack drawtext)
    uv run -q --no-project --with pillow python "$ROOT/tools/sheet.py" "$v" "$out" "$cols" "$fps" && return
    why="tools/sheet.py failed, error above"
  fi
  local dur rows; dur=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$v"); rows=$(python3 -c "import math;print(max(1,math.ceil($dur*$fps/$cols)))")
  rm -f "$out"; ffmpeg -v error -y -i "$v" -vf "fps=$fps,scale=480:-1,tile=${cols}x${rows}" -frames:v 1 "$out" || true
  [ -s "$out" ] || { echo "$c_no no contact sheet written: the ffmpeg fallback produced no frame ($why)" >&2; return 1; }
  echo "$out (no timestamps: $why)"
}
cmd_check() {
  local u="usage: bin/vh check <video> [--allow t,t…] [--against <reference.mp4>]"
  local v=${1:?$u} allow="" against="" fail=0
  shift
  while [ $# -gt 0 ]; do case "$1" in
    --allow) [ $# -ge 2 ] || { echo "bin/vh check: --allow needs the seconds of designed flashes, comma-separated (e.g. 1.0,3.2 or 12-15)" >&2; return 1; }
      allow=$2; shift 2 ;;
    --allow=*) allow=${1#--allow=}; shift ;;
    --against) [ $# -ge 2 ] || { echo "bin/vh check: --against needs the reference video (the approved 1080p cut)" >&2; return 1; }
      against=$2; shift 2 ;;
    --against=*) against=${1#--against=}; shift ;;
    *) echo "bin/vh check: unknown option $1 ($u)" >&2; return 1 ;;
  esac; done
  [ -z "$against" ] || [ -f "$against" ] || { echo "bin/vh check: no reference video at $against" >&2; return 1; }
  ffprobe -v error -show_entries format=duration:stream=codec_type,codec_name,width,height,r_frame_rate -of compact "$v"
  # spec: the frame size, rate and length against the project's BRIEF (Output, Resolution); playbook/01-pipeline.md, 规格
  local spec src=0
  if [ -n "$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_type -of csv=p=0 "$v" 2>/dev/null)" ]; then
    spec=$(python3 "$ROOT/tools/speccheck.py" "$v") || src=$?
    case "$src" in
      0) case "$spec" in *$'\nWARN '*) echo "$c_wa $spec" ;; *) echo "$c_ok $spec" ;; esac ;;
      1) fail=1; echo "$c_no $spec"; echo "   the render does not match the BRIEF: fix the render. Change the BRIEF's Output or Resolution line only when the spec itself changed" ;;
      *) echo "$c_wa spec check failed (error above)" ;;
    esac
  fi
  # gate ① on record: a standard or studio film is checked for release only once the person has decided its concept
  local gp gr grc=0; gp=$(project_of "$v")
  if [ -n "$gp" ]; then
    gr=$(python3 "$ROOT/tools/gatecheck.py" "$gp" --for check 2>&1) || grc=$?
    case "$grc:$gr" in
      0:*"no gates"*|0:*"not checked"*) ;;
      0:*) echo "$c_ok $gr" ;;
      1:"gate record"*) fail=1; printf '%s\n' "$gr" | sed "1s/^/$c_no /" ;;
      *) echo "$c_wa gate record check failed: $gr" ;;
    esac
  fi
  local hits; hits=$(ffmpeg -i "$v" -vf "blackdetect=d=0.3,freezedetect=d=3" -af silencedetect=d=3 -f null - 2>&1 | grep -E "black_|freeze_|silence_" | sed 's/.*\] //' || true)
  if [ -z "$hits" ]; then echo "$c_ok no black/freeze/silence segments over threshold"
  else echo "$hits"; echo "$c_wa review each hit: dark backgrounds (e.g. 3b1b black), intentional holds and silent videos trigger these by design"; fi
  # isolated frames: one frame unlike both neighbours while they agree (another scene flashed in, garbled text): a capture
  # glitch too short for freezedetect, and a snapshot of that time is clean (playbook/02-verification.md, 静默失败)
  local iso rc=0 py=() ia=("$v" --motion)   # --motion: cuts that flash, still stretches, the film's motion (warnings, from the same decode)
  [ -z "$allow" ] || ia+=(--allow "$allow")
  if command -v uv >/dev/null 2>&1; then py=(uv run -q --no-project --with numpy python)
  elif python3 -c "import numpy" 2>/dev/null; then py=(python3); fi
  if [ -z "$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_type -of csv=p=0 "$v" 2>/dev/null)" ]; then :   # audio only
  elif [ ${#py[@]} = 0 ]; then echo "$c_wa isolated-frame scan skipped: it needs numpy (install uv)"
  else
    iso=$("${py[@]}" "$ROOT/tools/isoframes.py" "${ia[@]}") || rc=$?
    iso=$(printf '%s\n' "$iso" | sed -e "s/^  static:/$c_wa static:/" -e "s/^  cuts:/$c_wa cuts:/" -e "s/^  periodic:/$c_wa periodic:/" -e "s/^  note:/$c_wa note:/")
    case "$rc:$iso" in   # uv also exits 1 when it cannot install numpy, so the words decide, not the status alone
      0:*) echo "$c_ok $iso" ;;
      1:[0-9]*" isolated frame"*) echo "$c_no $iso"
        echo "   a flash you designed (a flash frame, a flicker) is listed too: declare its time with --allow <s,s>. Otherwise snapshot"
        echo "   that time (HyperFrames: npx hyperframes snapshot --at <s> --describe false) and compare it with the mp4's frame"
        echo "   (ffmpeg -ss <s> -i <video> -frames:v 1 f.png)."
        echo "   A bad snapshot: the scene itself jumps there. A clean one: the render's capture glitched; for HyperFrames, re-render"
        echo "   with --no-browser-gpu --experimental-fast-capture=false and scan again (playbook/02-verification.md, 静默失败)" ;;
      3:*) rc=1; echo "$c_no isolated-frame scan: bad --allow (error above); nothing was declared" ;;   # a typo must not switch the gate off
      *) rc=2; echo "$c_wa isolated-frame scan failed (error above)" ;;
    esac
  fi
  # subtitles: the film's subtitle tracks and the .srt beside it, each entry long enough to read (a warning)
  local sub src2=0
  sub=$(python3 "$ROOT/tools/subcheck.py" "$v" 2>&1) || src2=$?
  case "$src2:$sub" in
    0:*) [ -n "$sub" ] && case "$sub" in "subtitles: none"*) ;; *) printf '%s\n' "$sub" | sed "s/^subtitles/$c_ok subtitles/" ;; esac ;;
    1:subtitles*) printf '%s\n' "$sub" | sed -e "s/^subtitles\(.*\)shorter than/$c_wa subtitles\1shorter than/" -e "s/^subtitles · \(.*\)long enough/$c_ok subtitles · \1long enough/" ;;
    *) echo "$c_wa subtitle check failed: $sub" ;;
  esac
  # colour: browsers read untagged or BT.601-tagged HD video with the wrong matrix (playbook/02-verification.md, 色彩标签)
  local col; col=$(ffprobe -v error -select_streams v:0 -show_entries stream=pix_fmt,color_range,color_space,color_transfer,color_primaries -of csv=p=0 "$v" 2>/dev/null)
  if [ -z "$col" ]; then :
  elif [ "$col" = "yuv420p,tv,bt709,bt709,bt709" ]; then echo "$c_ok colour: yuv420p, limited range, BT.709 with all four tags"
  else echo "$c_wa colour: $col (pix_fmt,range,matrix,transfer,primaries); deliver yuv420p, tv, bt709 ×3 — re-encode with the command in playbook/02-verification.md (色彩标签)"; fi
  # the publishing copy (PACKAGING.md, 发布文案) against the platforms' length limits: said, not a failure of the film
  local proj pk prc=0; proj=$(project_of "$v")
  if [ -n "$proj" ] && [ -f "$proj/PACKAGING.md" ]; then
    pk=$(python3 "$ROOT/tools/packcheck.py" "$proj/PACKAGING.md" 2>&1) || prc=$?
    case "$prc:$pk" in
      0:*"no 发布文案"*) ;;
      0:*) printf '%s\n' "$pk" | sed "s/^packaging/$c_ok packaging/" ;;
      1:*) echo "$c_wa the publishing copy in PACKAGING.md is over a platform's limit (playbook/10, 发布文案的长度):"; printf '%s\n' "$pk" | sed 's/^/   /' ;;
      *) echo "$c_wa packaging check failed: $pk" ;;
    esac
  fi
  # scale: a 4K render against the approved 1080p cut, so a layout that only breaks at device scale 2 shows up
  # (engines/README.md, 出 4K). Needs numpy, like the frame scan.
  if [ -n "$against" ]; then
    local sc arc=0
    if [ ${#py[@]} = 0 ]; then fail=1; echo "$c_no --against needs numpy (install uv)"
    else
      sc=$("${py[@]}" "$ROOT/tools/scalecheck.py" "$v" "$against" --sheet "$(dirname "$v")/check") || arc=$?
      case "$arc:$sc" in
        0:*"WARN "*) echo "$c_wa $sc" ;;
        0:*) echo "$c_ok $sc" ;;
        1:*"the picture differs"*) fail=1; echo "$c_no $sc"
          echo "   the two renders differ for half a second or more: look at the comparison images above. A label or panel at twice the"
          echo "   size or shifted is code reading canvas or image pixel sizes at devicePixelRatio 2 (engines/README.md, 出 4K)" ;;
        1:*"FAIL "*) fail=1; echo "$c_no $sc" ;;
        *) fail=1; echo "$c_no scale check failed (error above)" ;;
      esac
    fi
  fi
  [ "$rc" != 1 ] && [ "$fail" = 0 ]   # exit 1 on isolated frames, a spec mismatch, no gate ① on record or a scale FAIL; the other findings are for review
}
cmd_tts() {
  local proj=${1:?usage: bin/vh tts <project> [provider] [voice] [zh|en] [instruct] [--beats map.json --snap beat|half|downbeat] [--lead s] [--align gemini] [--join block|all] [--resume]} pos=() deps=""
  shift
  while [ $# -gt 0 ] && [ ${#pos[@]} -lt 4 ] && [[ "$1" != --* ]]; do pos+=("$1"); shift; done   # positionals stop at the first --flag
  local prov=${pos[0]:-qwen} voice=${pos[1]:-} lang=${pos[2]:-} instruct=${pos[3]:-} a prev=""
  for a in "$@"; do   # tts.py's own --provider X / --provider=X picks the dependencies too; the last one wins, as in argparse
    [ "$prev" = --provider ] && prov=$a
    case "$a" in --provider=*) prov=${a#--provider=} ;; esac
    prev=$a
  done
  # everything from the first --flag on goes straight to tts.py (--beats, --snap, --lead, --gap, --min-gap, --align, --join, --min-sim, --vocab, --resume)
  [ "$voice" = "-" ] && voice=""; [ "$lang" = "-" ] && lang=""; [ "$instruct" = "-" ] && instruct=""   # no lang: tts.py picks zh, or en for an English-only script
  case "$prov" in qwen) deps="--with mlx-audio" ;; edge) deps="--with edge-tts" ;; dashscope) deps="--with dashscope" ;; esac
  uv run -q --no-project $deps python "$ROOT/tools/audio/tts.py" "$proj" --provider "$prov" ${lang:+--lang "$lang"} ${voice:+--voice "$voice"} ${instruct:+--instruct "$instruct"} "$@"
}
cmd_voices() { [ $# -gt 0 ] || set -- list; python3 "$ROOT/tools/audio/tts.py" voices "$@"; }
cmd_pace() { # numpy for the waveform; mlx-whisper only with --align whisper (Apple Silicon)
  local a prev="" deps="--with numpy"
  for a in "$@"; do case "$prev:$a" in --align:whisper|*:--align=whisper) deps="$deps --with mlx-whisper" ;; esac; prev=$a; done
  uv run -q --no-project $deps python "$ROOT/tools/audio/pace.py" "$@"
}
cmd_captions() { # --media-end S: where a caption too short for its minimum may be lengthened to (default: the picture's length)
  local u="usage: bin/vh captions <project> [zh|en] [zh-max] [--en-max 42] [--cards] [--cps 9] [--media-end S] [--skip-lint]"
  local proj=${1:?$u}; shift
  local pos=() end=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --media-end) end+=(--media-end "${2:?$u}"); shift 2 ;;
      --skip-lint|--cards) end+=("$1"); shift ;;
      --cps|--en-max) end+=("$1" "${2:?$u}"); shift 2 ;;
      -*) echo "bin/vh captions: unknown option $1 ($u)" >&2; return 1 ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  set -- ${pos[@]+"${pos[@]}"}
  # word boundaries come from jieba: through uv when it has it cached (offline, at once), else one short try to fetch it
  # (a network that hangs costs seconds, not a minute), else plain python3 and the fallback
  local py=(python3)
  if command -v uv >/dev/null 2>&1; then
    if uv run -q --no-project --offline --with jieba python -c "import jieba" >/dev/null 2>&1; then py=(uv run -q --no-project --offline --with jieba python)
    elif UV_HTTP_TIMEOUT=8 UV_HTTP_RETRIES=0 uv run -q --no-project --with jieba python -c "import jieba" >/dev/null 2>&1; then py=(uv run -q --no-project --offline --with jieba python); fi
  fi
  PYTHONWARNINGS=ignore "${py[@]}" "$ROOT/tools/audio/captions.py" "$proj" ${1:+--lang "$1"} ${2:+--zh-max "$2"} ${end[@]+"${end[@]}"}
}
cmd_beats() { uv run -q --no-project --with librosa python "$ROOT/tools/audio/beats.py" "$@"; }
cmd_timeline() { [ $# -gt 0 ] || { cmd_usage timeline; exit 1; }; python3 "$ROOT/tools/audio/timeline_lint.py" "$@"; }
cmd_remap() { [ $# -gt 0 ] || { cmd_usage remap; exit 1; }; python3 "$ROOT/tools/audio/remap.py" "$@"; }
cmd_music() { # --roll draws pictures: pillow joins numpy and scipy only then
  local a pil=""; for a in "$@"; do [ "$a" = --roll ] && pil="--with pillow"; done
  uv run -q --no-project --with numpy --with scipy $pil python "$ROOT/tools/audio/music.py" "$@"; }
cmd_sfx() { # audition --png draws a spectrogram: pillow joins numpy and scipy only then
  local a pil=""; for a in "$@"; do [ "$a" = --png ] && pil="--with pillow"; done
  uv run -q --no-project --with numpy --with scipy $pil python "$ROOT/tools/audio/sfx.py" "$@"; }
cmd_mix() { # a mix profile computes in numpy/scipy (through uv); the default chain is ffmpeg only and runs on plain python3
  local a
  for a in "$@"; do case "$a" in profile=none) ;; profile=*) uv run -q --no-project --with numpy --with scipy python "$ROOT/tools/audio/mix.py" "$@"; return ;; esac; done
  python3 "$ROOT/tools/audio/mix.py" "$@"
}
cmd_qa() { uv run -q --no-project --with librosa python "$ROOT/tools/audio/qa.py" "$@"; }
cmd_mux() { # output length = video length (audio padded, or trimmed with a 40 ms fade-out); extra .srt args become soft subtitle tracks;
            # moov first (faststart), so a browser starts playing before the whole file has loaded
  local u="usage: bin/vh mux <video> <audio> <out> [--subs-off] [subs.srt…]"
  local v=${1:?$u} a=${2:?$u} out=${3:?$u}; shift 3
  local off="" subs=() f
  for f in "$@"; do case "$f" in --subs-off) off=1 ;; -*) echo "bin/vh mux: unknown option $f ($u)" >&2; return 1 ;; *) subs+=("$f") ;; esac; done
  set -- ${subs[@]+"${subs[@]}"}
  local vd ad fade=""; vd=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$v"); ad=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$a")
  if python3 -c "import sys; sys.exit(0 if float('$ad') > float('$vd') + 0.001 else 1)"; then   # longer audio: fade the last 40 ms instead of a hard cut
    fade=",afade=t=out:st=$(python3 -c "print(max(0.0, float('$vd') - 0.04))"):d=0.04"; fi
  local ins=(-i "$v" -i "$a") maps=(-map 0:v -map "[a]") meta=() i=2 s=0 lang
  for f in "$@"; do   # language from the file name only (captions.zh.srt, subs_en.srt, en.srt …), never from its folders
    lang=und; case "${f##*/}" in zh.*|*[._-]zh.*) lang=chi ;; en.*|*[._-]en.*) lang=eng ;; esac
    ins+=(-i "$f"); maps+=(-map "$i"); meta+=("-metadata:s:s:$s" "language=$lang"); i=$((i+1)); s=$((s+1))
  done
  ffmpeg -v error -y "${ins[@]}" -filter_complex "[1:a]apad,atrim=0:${vd}${fade}[a]" "${maps[@]}" -c:v copy -c:a aac -b:a 192k \
    ${1:+-c:s mov_text} ${meta[@]+"${meta[@]}"} ${off:+-disposition:s 0} -movflags +faststart "$out" || return 1
  if [ -n "$off" ] && [ $s -gt 0 ]; then   # --subs-off: no track starts switched on (the picture already has its captions burned in).
    # The MP4 muxer always enables the first subtitle track when none is default, so clear the enabled bit of every
    # subtitle track's tkhd in place (players read it as the default flag); the tracks stay listed and selectable.
    python3 - "$out" <<'PY' || return 1
import struct, sys
p = sys.argv[1]; b = bytearray(open(p, "rb").read())
def boxes(a, e):
    while a + 8 <= e:
        n, t = struct.unpack(">I4s", b[a:a + 8]); h = 8
        if n == 1: n, h = struct.unpack(">Q", b[a + 8:a + 16])[0], 16
        elif n == 0: n = e - a
        if n < h: break
        yield t, a + h, a + n
        a += n
for t, c, e in boxes(0, len(b)):
    for tt, tc, te in (boxes(c, e) if t == b"moov" else ()):
        if tt != b"trak": continue
        kids = {k: (kc, ke) for k, kc, ke in boxes(tc, te)}
        hdlr = next((bytes(b[hc + 8:hc + 12]) for h, hc, he in boxes(*kids.get(b"mdia", (0, 0))) if h == b"hdlr"), b"")
        if b"tkhd" in kids and hdlr in (b"sbtl", b"subt", b"text"):
            b[kids[b"tkhd"][0] + 3] &= 0xFE
open(p, "wb").write(b)
PY
  fi
  echo "$c_ok $out${1:+ (+$s subtitle track(s)${off:+, off by default})}"
}
cmd_deliver() { [ $# -gt 0 ] || { cmd_usage deliver; exit 1; }; python3 "$ROOT/tools/deliver.py" "$@"; }   # ffmpeg only
cmd_clean() { [ $# -gt 0 ] || { cmd_usage clean; exit 1; }; python3 "$ROOT/tools/clean.py" "$@"; }         # stdlib only
cmd_gif() {
  local v=${1:?usage: bin/vh gif <video> [width] [fps]} w=${2:-640} fps=${3:-15} b out; b=${v##*/}; out="${v%"$b"}${b%.*}.gif"   # extension off the file name, not a dotted folder
  ffmpeg -v error -y -i "$v" -vf "fps=$fps,scale=$w:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=128:stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=4" "$out" && ls -lh "$out" | awk '{print $5, $9}'
}

cmd_help() { awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; }
cmd_usage() { # one command's lines from the header above, with their continuation lines; exit 1 if it has none
  c=$1 awk 'NR == 1 {next} !/^#/ {exit}
    /^#   [^ ]/ {split(substr($0, 5), w, " "); on = (w[1] == ENVIRON["c"]); if (on) {found = 1; print "usage: bin/vh " substr($0, 5)}; next}
    on && /^#     / {sub(/^# +/, ""); print "              " $0; next}
    {on = 0}
    END {exit !found}' "$0"
}

case "${2:-}" in -h|--help)   # `bin/vh <command> -h` prints its usage instead of running it with -h as a file, project or preset name
  case "$1" in captions|readcheck|review|storyboard|rhythm|cover-preview|voices|mix|recipes|sfx|qa) ;;   # these print their own, fuller help
    tts) cmd_usage tts; echo; exec python3 "$ROOT/tools/audio/tts.py" -h ;;   # + every flag, without building the mlx-audio environment first
    pace) cmd_usage pace; echo; exec python3 "$ROOT/tools/audio/pace.py" -h ;;
    frames|render|determinism|cues|patch|bake) cmd_usage "$1"; echo; exec node "$ROOT/tools/film/$1.mjs" -h ;;   # + every flag
    *) cmd_usage "$1" && exit 0 ;; esac ;;
esac

case "${1:-help}" in
  doctor) cmd_doctor ;; setup) cmd_setup ;; types) cmd_types ;;
  tts) shift; cmd_tts "$@" ;; pace) shift; cmd_pace "$@" ;; voices) shift; cmd_voices "$@" ;; captions) shift; cmd_captions "$@" ;; timeline) shift; cmd_timeline "$@" ;; remap) shift; cmd_remap "$@" ;; music) shift; cmd_music "$@" ;; sfx) shift; cmd_sfx "$@" ;; beats) shift; cmd_beats "$@" ;; mix) shift; cmd_mix "$@" ;; qa) shift; cmd_qa "$@" ;; mux) shift; cmd_mux "$@" ;;
  install-skill) shift; cmd_install_skill "$@" ;;
  recipes) shift; python3 "$ROOT/tools/recipes.py" "$@" ;;
  review) shift; cmd_review "$@" ;;
  desk) shift; cmd_desk "$@" ;;
  new) shift; cmd_new "$@" ;; style) shift; cmd_style "$@" ;; readcheck) shift; cmd_readcheck "$@" ;; textcheck) shift; cmd_textcheck "$@" ;; frames) shift; cmd_frames "$@" ;; bake) shift; cmd_bake "$@" ;; render) shift; cmd_film_tool render "$@" ;; fonts) shift; cmd_fonts "$@" ;; determinism) shift; cmd_film_tool determinism "$@" ;; cues) shift; cmd_film_tool cues "$@" ;; patch) shift; cmd_film_tool patch "$@" ;;
  storyboard) shift; cmd_storyboard "$@" ;; rhythm) shift; cmd_rhythm "$@" ;; cover-preview) shift; cmd_cover_preview "$@" ;; effort) shift; cmd_effort "$@" ;; sync-agents) cmd_sync_agents ;; hf-init) shift; cmd_hf_init "$@" ;; sheet) shift; cmd_sheet "$@" ;; check) shift; cmd_check "$@" ;; gif) shift; cmd_gif "$@" ;; deliver) shift; cmd_deliver "$@" ;; clean) shift; cmd_clean "$@" ;;
  help|-h|--help) cmd_help ;;
  *) { echo "unknown command: $1"; echo; cmd_help; } >&2; exit 1 ;;
esac
